# ─────────────────────────────────────────────────────────────────────────────
# PerfStudio — Docker environment variables
# Copy this file to .env.docker and fill in your values.
# docker compose uses this file automatically via env_file in docker-compose.yml
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED: change to a long random string before going to production
JWT_SECRET=change_me_to_a_long_random_string_before_production
ENCRYPTION_KEY=change_me_32_char_key_for_git_token_encryption

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Execution mode ────────────────────────────────────────────────────────────
# Set to "native" to use JMeter/K6 binaries built into the image (recommended).
# Set to "docker" to use Docker-in-Docker (requires Docker socket mount).
EXECUTION_MODE=native

# ── SMTP (for alert emails) ───────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=PerfStudio <your@gmail.com>

# ── CORS (set to your frontend URL if running separately) ─────────────────────
# CORS_ORIGIN=https://your-domain.com
