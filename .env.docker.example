# ─────────────────────────────────────────────────────────────────────────────
# PerfStudio — Docker environment variables
# Copy this file to .env.docker and fill in your values.
# docker compose uses this file automatically via env_file in docker-compose.yml
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED: change to a long random string before going to production
JWT_SECRET=change_me_to_a_long_random_string_before_production
ENCRYPTION_KEY=change_me_32_char_key_for_git_token_encryption

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Execution mode ────────────────────────────────────────────────────────────
# Set to "native" to use JMeter/K6 binaries built into the image (recommended).
# Set to "docker" to use Docker-in-Docker (requires Docker socket mount).
EXECUTION_MODE=native

# ── SMTP (for alert emails) ───────────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=PerfStudio <your@gmail.com>

# ── S3 storage (REQUIRED — the app refuses to start without this) ────────────
# All customer data (git workspaces, run results, generated artifacts) is stored in
# S3 only, never on local/container disk (GDPR zero-local-disk requirement). The app
# probes the bucket at boot and exits if it isn't reachable.
S3_SYNC_ENABLED=true
S3_BUCKET=
S3_REGION=
# Only set this to point at an S3-compatible endpoint (e.g. MinIO) instead of real AWS S3.
# S3_ENDPOINT=
# Leave both blank when running on AWS (EC2/ECS/EKS) with an instance/task IAM role —
# the SDK's default credential chain picks that up automatically and is preferred over
# static keys (least privilege, no rotation to manage). Only set these for non-AWS hosting.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_PREFIX=git-workspaces

# ── SSH-mode git workspaces — tmpfs sizing (docker-compose.yml) ───────────────
# RAM (+swap) reserved for the /app/git-workspaces tmpfs mount. Only SSH-mode auth
# workspaces live here (PAT-mode is fully S3-backed) — size for your expected number of
# concurrent SSH-mode workspaces. Default 6g assumes ~20 concurrent workspaces x ~200MB.
GIT_WORKSPACES_TMPFS_SIZE=6g

# ── Ops alerting (S3 upload/sync failures) ────────────────────────────────────
# Optional webhook (e.g. Slack incoming webhook, PagerDuty events endpoint) that gets a
# JSON POST whenever an S3 operation fails. Also alerts by email to every org_admin/
# super_admin via the SMTP config above (or any admin's SMTP config saved in-app), if set.
# OPS_ALERT_WEBHOOK_URL=

# ── Branding (optional) ───────────────────────────────────────────────────────
# URL to your organisation's logo — shown in UI header and email templates.
# Leave commented out to show no logo (app name text only).
# APP_LOGO_URL=https://your-domain.com/logo.png

# ── CORS (set to your frontend URL if running separately) ─────────────────────
# CORS_ORIGIN=https://your-domain.com
