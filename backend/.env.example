# ── PerfStudio Backend — Environment Configuration ────────────────────────────
# Direct deployment (no containers) — see docs/DEPLOYMENT.md and docs/LOCAL_SETUP.md.
# Copy this file to `backend/.env` for local dev, or `backend/.env.production` for a
# production deployment (referenced by the systemd unit's EnvironmentFile= in
# docs/DEPLOYMENT.md §8), and fill in the required values.
# ──────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development


# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED — PostgreSQL connection string. SQLite is not supported.
# Local dev example: postgresql://postgres:postgres@localhost:5432/perf_studio
DATABASE_URL=


# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret


# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin(s) allowed to call the API — set to your frontend's public URL.
# ⚠ Note: as of this writing, the backend's CORS middleware allows all origins
# regardless of this value (the code's own comment: "allow all in current setup —
# restrict in production"). Set this correctly anyway so it's ready once enforced.
CORS_ORIGIN=http://localhost:5173


# ── File storage — local filesystem paths ──────────────────────────────────────
# Relative paths from backend/, resolved directly by Node — legacy/admin project
# files and ZIP backups only, not where scripts/results live (those are S3-backed).
PROJECTS_ROOT=../projects
BACKUPS_ROOT=../backups


# ── Vestigial — no effect, safe to ignore ──────────────────────────────────────
# Local/native test execution is retired (every route returns HTTP 410) — real test
# execution is CI-only (GitHub Actions/GitLab CI/Bitbucket Pipelines). These are read
# only by confirmed-dead code; nothing needs to be set here.
JMETER_DOCKER_IMAGE=justb4/jmeter:latest
K6_DOCKER_IMAGE=grafana/k6:latest


# ── S3-backed storage (⚠ REQUIRED — the app refuses to boot without this) ─────
# Corrected 2026-07-31: this was originally written as an optional feature and shipped
# with S3_SYNC_ENABLED=false as the default — that default is WRONG as of the 2026-07
# GDPR/zero-local-disk migration (git log: 8a97fb1, 15e7026, c93b872). `backend/src/
# index.js` now calls assertBucketReachable() at startup and exits the process
# (process.exit(1)) if S3_SYNC_ENABLED isn't "true" or S3_BUCKET isn't reachable —
# there is no supported way to run this app without S3 in any environment (dev or
# production). All git workspace data (PAT-auth mode) and ALL test-run results (JTL,
# HTML report, PDF) live in S3 only — never on local disk, not even transiently.
# For local dev without a real AWS account, run the MinIO server binary directly
# (not via a container) — see docs/LOCAL_SETUP.md §4.
S3_SYNC_ENABLED=true
S3_BUCKET=
S3_REGION=
# Only needed for an S3-compatible endpoint (e.g. MinIO) instead of real AWS S3.
S3_ENDPOINT=
# Leave blank on AWS (EC2/ECS/EKS) with an instance/task IAM role attached — the SDK's
# default credential chain picks it up automatically (preferred: least privilege, no
# rotation to manage). Only set these explicitly for non-AWS hosting or local MinIO.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=git-workspaces
# How long (ms) a PAT-mode workspace's file bytes stay cached in-process (gitEngine.js)
# between requests before eviction and re-download from S3 on next use. Default 15 min.
GIT_ENGINE_SESSION_CACHE_TTL_MS=900000
# Note: SSH-auth-mode git workspaces (the one thing that still touches local disk) are
# recommended to live on a real Linux tmpfs mount for ephemerality — see docs/DEPLOYMENT.md
# §3, Step 10. That's an OS-level filesystem mount, not an env var, so there's nothing to
# set here for it.
# SSH-auth-mode workspaces only (utils/workspaceLifecycle.js) — how long (ms) a workspace
# sits on disk, confirmed-synced-but-untouched, before the background sweep reclaims it.
# Default 24h — same-day work never pays a rehydration cost.
S3_WORKSPACE_COOLDOWN_MS=86400000
# How often (ms) the background sweep runs. Default 30 minutes.
S3_SWEEP_INTERVAL_MS=1800000
# Optional webhook (Slack/PagerDuty-style) notified on S3 operation failures, in addition
# to email alerting via utils/opsAlert.js to every org_admin/super_admin.
OPS_ALERT_WEBHOOK_URL=


# ── Artifact Keeper — org npm registry tokens (@peako packages) ───────────────
# Used to provision/rotate/revoke each organization's npm registry token.
# Leave unset in dev — token operations fail non-fatally (org creation/status
# changes still succeed, just without a registry token attached).
ARTIFACT_KEEPER_URL=https://artifact-keeper.qtsolvdev.com
ARTIFACT_KEEPER_API_KEY=
