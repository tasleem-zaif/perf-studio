# ── PerfStudio Backend — Environment Configuration ────────────────────────────
# Copy this file to .env (in the repo root, next to docker-compose.yml) and
# fill in the required values.  The .env file is read by Docker Compose for
# variable substitution and also loaded by Node.js via dotenv in dev mode.
# ──────────────────────────────────────────────────────────────────────────────


# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development


# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED — PostgreSQL connection string. SQLite is not supported.
# Local dev example: postgresql://postgres:postgres@localhost:5432/perf_studio
DATABASE_URL=


# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret


# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin(s) allowed to call the API. In Docker Compose the frontend container
# proxies API calls so the browser origin is the frontend's public URL.
CORS_ORIGIN=http://localhost:5173


# ── File storage — container-internal paths ───────────────────────────────────
# These paths are used for file I/O inside the Node process / container.
# In dev mode (no Docker): relative paths from backend/ are resolved by Node.
# In Docker Compose: use absolute container paths matching the volume mounts.
PROJECTS_ROOT=../projects
BACKUPS_ROOT=../backups


# ── Docker test execution — HOST machine paths ────────────────────────────────
# REQUIRED when running the backend inside Docker Compose.
#
# When the backend container spawns JMeter/K6 containers via the Docker socket,
# the -v volume mount paths must reference the HOST filesystem (not the container
# filesystem). Set these to the absolute path on the HOST where ./projects and
# ./backups live.
#
# Windows example:
#   HOST_PROJECTS_ROOT=C:/Users/YourName/perf-studio/projects
#   HOST_BACKUPS_ROOT=C:/Users/YourName/perf-studio/backups
#
# Linux/macOS example:
#   HOST_PROJECTS_ROOT=/home/yourname/perf-studio/projects
#   HOST_BACKUPS_ROOT=/home/yourname/perf-studio/backups
#
# In dev mode (backend runs directly on host, not in Docker): leave blank —
# PROJECTS_ROOT is used as-is for volume mounts.
HOST_PROJECTS_ROOT=
HOST_BACKUPS_ROOT=


# ── Docker Compose port mapping (only used by docker-compose.yml) ─────────────
BACKEND_PORT=3001
FRONTEND_PORT=5173


# ── Default Docker images for test execution ──────────────────────────────────
# These are the default images used when no image is configured in the UI.
# Users can override per-session in Configuration → Docker Engine → Test Tool Images.
JMETER_DOCKER_IMAGE=justb4/jmeter:latest
K6_DOCKER_IMAGE=grafana/k6:latest


# ── S3 project-data offload (optional, off by default) ────────────────────────
# When enabled, git workspace data is uploaded to S3 once a push is confirmed to have
# landed on the remote, and the local copy is reclaimed after a cooldown period of no
# activity — keeps git-workspaces/ from growing unbounded on the server's own disk.
# Local disk remains the working copy at all times; nothing here changes normal editing,
# running tests, or git commit/push behavior. Leave S3_SYNC_ENABLED unset/false to disable
# entirely — every S3 call becomes a no-op and local disk behaves exactly as it does today.
S3_SYNC_ENABLED=false
S3_BUCKET=
S3_REGION=
# Only needed for an S3-compatible endpoint (e.g. MinIO) instead of real AWS S3.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=git-workspaces
# How long (ms) a workspace sits on disk, confirmed-synced-but-untouched, before the
# background sweep reclaims it. Default 24h — same-day work never pays a rehydration cost.
S3_WORKSPACE_COOLDOWN_MS=86400000
# How often (ms) the background sweep runs. Default 30 minutes.
S3_SWEEP_INTERVAL_MS=1800000


# ── Artifact Keeper — org npm registry tokens (@peako packages) ───────────────
# Used to provision/rotate/revoke each organization's npm registry token.
# Leave unset in dev — token operations fail non-fatally (org creation/status
# changes still succeed, just without a registry token attached).
ARTIFACT_KEEPER_URL=https://artifact-keeper.qtsolvdev.com
ARTIFACT_KEEPER_API_KEY=
