flowchart TB
    subgraph Auth["Authentication"]
        A1["JWT HS256 default (algorithm not explicitly pinned)<br/>7-day expiry<br/>stored in localStorage"]
        A2["bcrypt, 10 rounds<br/>password hashing"]
        A3["Password Reset<br/>30-min token, expires on use"]
    end

    subgraph Authz["Authorization"]
        Z1["auth middleware<br/>verifies JWT + session on every route"]
        Z2["Role checks<br/>super_admin, org_admin, user"]
        Z3["ownsProject()<br/>owner, assigned, or org scope"]
    end

    subgraph Lic["License Enforcement"]
        L1["getOrgAccessStatus()<br/>checked on every request"]
        L2["403 org_disabled / license_expired<br/>when disabled or past expiry"]
    end

    subgraph Enc["Encryption at Rest"]
        E1["AES-256-CBC<br/>all secrets in PostgreSQL"]
        E2["Encrypted: AI API keys, Git PATs,<br/>SMTP passwords, CI tokens"]
        E3["⚠ Key falls back to JWT_SECRET, then a<br/>hardcoded default, if ENCRYPTION_KEY unset —<br/>always set explicitly"]
    end

    subgraph Net["Network Security"]
        N1["⚠ CORS currently permissive<br/>(code's own comment: 'allow all in current<br/>setup — restrict via CORS_ORIGIN in production')"]
        N2["SSRF Protection<br/>blocks RFC1918 + loopback in pre-run's<br/>live outbound requests"]
        N3["PAT injection<br/>at runtime only, never in .git/config"]
        N4["No rate limiting, no Helmet/security-headers<br/>middleware detected"]
    end

    subgraph Store["Storage Security"]
        S1["S3 mandatory at boot — assertBucketReachable()<br/>all git workspace + run-result data lives here"]
        S2["SSH-mode git workspaces: tmpfs (RAM-backed),<br/>not persisted across container restart"]
    end

    Auth --> Authz --> Lic --> Enc --> Net --> Store
