# ── PerfStudio — Environment Configuration (Docker Compose — undocumented/legacy) ─────
# ⚠ The documented deployment model is now DIRECT (a plain Node.js process, no
# containers) — see docs/DEPLOYMENT.md and docs/LOCAL_SETUP.md, and use
# backend/.env.example as your template instead of this file.
#
# This file and docker-compose.yml still exist and still work, but they're no longer
# the recommended/documented way to run Peako. Kept here for anyone who was already
# using the Docker Compose setup and wants to keep doing so.
#
# Copy this file to .env (next to docker-compose.yml) and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────
#
# Note: docker-compose.yml's PerfStudio service reads its actual container runtime env
# from `.env.docker` (via `env_file:`), NOT from this `.env` file. This `.env` is only
# used by Docker Compose for its own ${VAR} substitutions (image tag, exposed PORT,
# tmpfs size) and all of those already have working defaults. For the actual required
# config (JWT_SECRET, ENCRYPTION_KEY, DATABASE_URL, and the mandatory S3_* variables),
# copy and edit `.env.docker.example` → `.env.docker` instead.


# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production


# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED — PostgreSQL connection string. SQLite is not supported.
# Local dev example: postgresql://postgres:postgres@localhost:5432/perf_studio
# Docker Compose (all-in-one) sets this automatically — no action needed there.
DATABASE_URL=


# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret


# ── Frontend URL ──────────────────────────────────────────────────────────────
# REQUIRED — public URL where the frontend is accessible.
# Used to build invite links and password reset links in emails.
# Examples:
#   http://localhost:5173          (local dev)
#   http://192.168.1.10:5173       (LAN access)
#   https://your-ngrok-url.ngrok-free.app  (ngrok tunnel)
#   https://perf.yourcompany.com   (production domain)
FRONTEND_URL=http://localhost:5173


# ── CORS ──────────────────────────────────────────────────────────────────────
# Must match FRONTEND_URL (or be a comma-separated list for multiple origins)
CORS_ORIGIN=http://localhost:5173


# ── File storage — container-internal paths ───────────────────────────────────
PROJECTS_ROOT=../projects
BACKUPS_ROOT=../backups


# ── Docker test execution — HOST machine paths ────────────────────────────────
# REQUIRED when running backend inside Docker Compose.
# Must point to the absolute path on the HOST where ./projects lives.
#
# Windows example:
#   HOST_PROJECTS_ROOT=C:/Users/YourName/perf-studio/projects
# Linux/macOS example:
#   HOST_PROJECTS_ROOT=/home/yourname/perf-studio/projects
HOST_PROJECTS_ROOT=
HOST_BACKUPS_ROOT=


# ── Docker Compose port mapping ───────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=5173


# ── Test execution Docker images (VESTIGIAL — no effect) ────────────────────
# Local/Docker-spawned test execution is retired (every such route returns HTTP 410).
# Real test execution is CI-only (GitHub Actions/GitLab CI/Bitbucket Pipelines) — these
# vars are read only by confirmed-dead code and can be left as-is or removed.
JMETER_DOCKER_IMAGE=justb4/jmeter:latest
K6_DOCKER_IMAGE=grafana/k6:latest


# ── Encryption ────────────────────────────────────────────────────────────────
# REQUIRED — 32-byte hex key for AES-256-CBC encryption of API keys and tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_generate_a_32_byte_hex_key

# ── Branding (optional) ───────────────────────────────────────────────────────
# URL to your organisation's logo shown in the UI and email templates.
# Leave commented out to show no logo (text only).
# APP_LOGO_URL=https://your-domain.com/logo.png


# ── Artifact Keeper — org npm registry tokens (@peako packages) ───────────────
# Used to provision/rotate/revoke each organization's npm registry token.
# Leave unset in dev — token operations fail non-fatally.
ARTIFACT_KEEPER_URL=https://artifact-keeper.qtsolvdev.com
ARTIFACT_KEEPER_API_KEY=
